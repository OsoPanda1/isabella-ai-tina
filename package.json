{
  "name": "tanamv-isabella-ai-genesis",
  "version": "4.3.3",
  "description": "Isabella AI Genesis — sistema federado de inteligencia artificial gobernada.",
  "packageManager": "pnpm@10.34.5",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "pnpm": {
    "overrides": {
      "undici": ">=6.28.0",
      "@vercel/static-config>ajv": ">=8.18.0",
      "deepmerge-ts": ">=8.0.0",
      "mysql2": ">=3.23.1"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "attestation:keygen": "node scripts/attestation-keygen.mjs",
    "attestation:verify": "node scripts/attestation-keygen.mjs --all --verify",
    "audit:imports": "node scripts/audit-internal-imports.mjs",
    "audit:repository": "node scripts/repository-audit.mjs",
    "audit:documents": "node scripts/document-inventory.mjs",
    "audit:architecture": "node scripts/audit-architecture.mjs",
    "audit:dependencies": "pnpm audit --prod",
    "audit:recipes": "node scripts/verify-recipe.mjs --check",
    "audit:routes": "node scripts/genesis-route-audit.mjs",
    "build": "vite build && node scripts/generate-client-shell.mjs",
    "build:dev": "node scripts/check-env.mjs && vite build --mode development",
    "build:production": "NODE_ENV=production vite build",
    "capabilities": "node scripts/capability-matrix.mjs --check",
    "clean:install": "bash scripts/clean-install.sh",
    "db:backup": "node scripts/db-backup.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:neon:preflight": "node scripts/db-neon-preflight.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "db:verify": "node scripts/db-verify.mjs",
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "format": "prettier --write .github/workflows/*.yml",
    "format:check": "prettier --check .github/workflows/*.yml",
    "hypercore:serve": "node hypercore-runtime/src/server.mjs",
    "hypercore:test": "node --test hypercore-runtime/test/hypercore.test.mjs",
    "k8s:image:verify": "node scripts/k8s-image-pin.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ncua:benchmark": "vitest run test/unit/ncua-benchmark.test.ts",
    "ncua:live": "node scripts/ncua-live-load.mjs",
    "ncua:load": "vitest run test/security/ncua-load.test.ts",
    "policy:check": "node scripts/policy-as-code.mjs",
    "postinstall": "prisma generate",
    "preflight": "node scripts/production-preflight.mjs",
    "production:gate": "node scripts/production-integrity-gate.mjs",
    "production:preflight": "node scripts/production-preflight.mjs",
    "sbom": "node scripts/sbom.mjs",
    "sbom:verify": "node scripts/sbom-verify.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "security:scan": "eslint --config eslint.security.mjs . && node scripts/secret-scan.mjs",
    "spellcheck": "cspell .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --pretty false",
    "verify:lock": "pnpm install --frozen-lockfile",
    "verify:routes": "node scripts/genesis-route-audit.mjs --verify"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@hookform/resolvers": "^5.2.2",
    "@idlen/chat-sdk": "1.0.5",
    "@mux/mux-player-react": "^3.13.4",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.117.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.40",
    "@types/react-window": "^1.8.8",
    "@types/three": "^0.186.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/connect": "^2.3.0",
    "@vercel/node": "^16.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.113",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^15.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "framer-motion": "^13.4.4",
    "h3": "2.0.1-rc.31",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "lenis": "^1.2.3",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "motion": "^13.4.4",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.5",
    "react-hook-form": "^7.88.0",
    "react-resizable-panels": "^4.13.3",
    "react-window": "^1.8.11",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.2.1",
    "three": "^0.186.0",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
